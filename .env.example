APP_MODE=demo
DB_BACKEND=sqlite
SQLITE_PATH=data/personal-agent.db
# -DemoOnly explicitly sets this false for the API process.
INTEGRATIONS_ENABLED=true
# Optional controlled clock for a fresh demo database; must include a UTC offset.
DEMO_NOW=
LOCAL_ROUTING_POLICY=specialist_first
# Credentials are server-side only. Never commit real values.
# Optional read-only resource discovery; this is not a SQL password.
SINGLESTORE_API_KEY=
SINGLESTORE_HOST=
SINGLESTORE_PORT=3306
SINGLESTORE_USER=
SINGLESTORE_PASSWORD=
SINGLESTORE_DATABASE=
SIE_API_KEY=
SIE_BASE_URL=https://api.superlinked.com
SIE_RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
AMPLITUDE_API_KEY=
AMPLITUDE_SERVER_ZONE=US
STATSIG_SERVER_SECRET_KEY=
# Legacy alias also accepted:
STATSIG_SERVER_SECRET=
# Live retrieval and required-claim evaluation; server-side key only.
# Approved sources are in ignored .local/senso-corpus-ledger.json.
SENSO_API_KEY=
# Tenant REST API for the separate bounded sample/synthetic memory job.
COGNEE_API_KEY=
COGNEE_BASE_URL=
# Blank selects live Senso and fails closed if its key/source ledger is missing.
# Use fixture or offline only for an explicitly labeled fixture run.
EVIDENCE_PROVIDER=
# Backend tool credential; configure matching Authorization: Bearer in Guild.
BACKGROUND_TOOL_TOKEN=
# Legacy alias:
GUILD_BACKEND_TOKEN=
